                "text": "{% set matched_permissions = [] %}\r\n{% for endpoint in CTX.endpoints %}\r\n    {% for permission in CTX.permission_list %}\r\n        {% set api_parts = permission.API.split(' ') %}\r\n        {% if api_parts | length > 1 and api_parts[1] == endpoint %}\r\n            {% if permission not in matched_permissions %}\r\n                {% do matched_permissions.append(permission) %}\r\n            {% endif %}\r\n        {% endif %}\r\n    {% endfor %}\r\n{% endfor %}\r\n{{-\r\n    [\r\n        {\r\n            \"PermissionName\": perm.PermissionName,\r\n            \"ApplicationPermission\": perm.ApplicationPermission,\r\n            \"DelegatePermission\": perm.DelegatePermission,\r\n            \"IsBeta\": perm.IsBeta,\r\n            \"API\": perm.API,\r\n            \"DocUri\": perm.DocUri\r\n        }\r\n        for perm in matched_permissions\r\n    ]\r\n-}}"
